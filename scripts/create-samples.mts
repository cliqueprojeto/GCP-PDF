import {mkdir,readFile,writeFile} from 'node:fs/promises';
import {PDFDocument,rgb} from 'pdf-lib';
import fontkit from '@pdf-lib/fontkit';
import {createCanvas,GlobalFonts} from '@napi-rs/canvas';
await mkdir('evidence/fixtures',{recursive:true});
const fontBytes=await readFile('assets/Inter-Regular.ttf');
async function create(name:string,pages:number){const doc=await PDFDocument.create();doc.registerFontkit(fontkit);const font=await doc.embedFont(fontBytes);for(let n=0;n<pages;n++){const page=doc.addPage([595.28,841.89]);page.drawRectangle({x:0,y:785,width:595.28,height:57,color:rgb(.36,.17,.69)});page.drawText('GESTÃO CULTURAL PRO',{x:42,y:805,size:14,font,color:rgb(1,1,1)});page.drawText(n===0?'Relatório de produção cultural':'Declaração e assinaturas',{x:42,y:737,size:25,font,color:rgb(.2,.14,.32)});page.drawText('Documento sintético de validação • GCP-PDF',{x:42,y:707,size:10,font,color:rgb(.45,.42,.49)});const rows=[['Descrição','Quantidade','Valor (R$)'],['Oficina de criação','12','1.234,50'],['Produção e divulgação','3','2.450,00'],['Acessibilidade e inclusão','2','980,75']];for(let r=0;r<rows.length;r++){if(r===0)page.drawRectangle({x:42,y:627,width:510,height:34,color:rgb(.94,.91,.99)});for(let c=0;c<3;c++)page.drawText(rows[r][c],{x:[52,340,438][c],y:640-r*37,size:11,font,color:rgb(.2,.17,.27)});}page.drawText('Esta edição preserva acentuação: ação, café, São Paulo e informação.',{x:42,y:425,size:11,font});page.drawText('Abra em duas janelas e arraste uma miniatura para comparar versões.',{x:42,y:400,size:10,font});page.drawText('Assinatura do responsável:',{x:42,y:300,size:11,font});page.drawLine({start:{x:42,y:240},end:{x:310,y:240},thickness:.8,color:rgb(.65,.6,.7)});page.drawText(`Página ${n+1} de ${pages}`,{x:470,y:28,size:9,font});}await writeFile('evidence/fixtures/'+name,await doc.save());}
await create('relatorio-cultural.pdf',2);await create('anexo-cultural.pdf',1);
GlobalFonts.registerFromPath('assets/Inter-Regular.ttf','Inter');const canvas=createCanvas(1600,1000),ctx=canvas.getContext('2d');ctx.fillStyle='#ffffff';ctx.fillRect(0,0,1600,1000);ctx.fillStyle='#16111f';ctx.font='54px Inter';ctx.fillText('DECLARAÇÃO DE PARTICIPAÇÃO',85,160);ctx.font='38px Inter';ctx.fillText('Gestão Cultural Pro',85,260);ctx.fillText('Ação cultural e inclusão em São Paulo.',85,340);ctx.fillText('Informação, produção e criação artística.',85,420);const image=canvas.toBuffer('image/png');await writeFile('evidence/fixtures/declaracao.png',image);const scan=await PDFDocument.create(),png=await scan.embedPng(image);scan.addPage([800,500]).drawImage(png,{x:0,y:0,width:800,height:500});await writeFile('evidence/fixtures/digitalizado.pdf',await scan.save());console.log('Amostras locais criadas.');
